  audioSource: {fileID: 0}
  tier1:
    trophy: {fileID: -8822665449544939422, guid: 43e554e054507be448589296caf20c39, type: 3}
    title: "\xA1Cada gran descubrimiento empieza con un intento!"
    message: "La ciencia est\xE1 llena de preguntas, pruebas y nuevos comienzos. Sigue explorando, aprendiendo y confiando en tu curiosidad. \xA1Tu aventura STEM apenas comienza!"
    sound: {fileID: 0}
  tier2:
    trophy: {fileID: -6701165621028275949, guid: cca0adc911652c3468c9100d5ef0292b, type: 3}
    title: "T\xEDtulo: \xA1Vas por muy buen camino!"
    message: "\xA1Tus conocimientos est\xE1n creciendo! Has demostrado curiosidad y dedicaci\xF3n. Cada respuesta te acerca a nuevos descubrimientos. \xA1Sigue adelante, futura innovadora!"
    sound: {fileID: 0}
  tier3:
    trophy: {fileID: -3571453731875283761, guid: 1a750996aaed9d64a93b4c5433518b3a, type: 3}
    title: "\xA1Tu talento STEM est\xE1 brillando!"
    message: "\xA1Impresionante! Demostraste grandes conocimientos y una mente llena de potencial. Sigue haciendo preguntas, creando ideas y explorando nuevas posibilidades. \xA1Puedes llegar muy lejos!"
    sound: {fileID: 0}
  tier4:
    trophy: {fileID: 2704208188245951875, guid: 72b70ece5ed5ae04e98f5ee5a03b4c74, type: 3}
    title: "\xA1Eres una verdadera estrella STEM!"
    message: "\xA1Extraordinario! Tu conocimiento, curiosidad y dedicaci\xF3n te han llevado a lo m\xE1s alto. El mundo necesita mentes como la tuya para imaginar, descubrir y transformar el futuro. \xA1Sigue brillando!"
    sound: {fileID: 0}
  soundVolume: 1
